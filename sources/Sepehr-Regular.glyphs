{
code = "###
# OpenType Layout feature definitions
# Format: Adobe FDK for OpenType (AFDKO) version 2.5
# Generated on: 2026-10-15 21:21
# Generated by: FontLab 8.0.0
# Font PostScript name: Parastoo-Regular
# Font copyright: Copyright 2016 The Parastoo Project Authors (https://github.com/googlefonts/parastoo-font)
#
# Totals:
# Languagesystems: 13
# GSUB lookups: 30
# GSUB features: 14 (aalt, case, ccmp, fina, frac, init, liga, locl, medi, ordn, pnum, rlig, sups, tnum)
# GPOS lookups: 13
# GPOS features: 3 (kern, mark, mkmk)

#
# Languagesystem definitions
#

languagesystem DFLT dflt; # Default default
languagesystem latn dflt; # Latin default
languagesystem latn AZE ; # Latin Azerbaijani
languagesystem latn CAT ; # Latin Catalan
languagesystem latn CRT ; # Latin Crimean Tatar
languagesystem latn KAZ ; # Latin Kazakh
languagesystem latn MOL ; # Latin Moldavian
languagesystem latn ROM ; # Latin Romanian
languagesystem latn TAT ; # Latin Tatar
languagesystem latn TRK ; # Latin Turkish
languagesystem arab dflt; # Arabic default
languagesystem arab ARA ; # Arabic Arabic
languagesystem grek dflt; # Greek default

#
# Lookup definitions
#


#
# Feature definitions
#
";
tag = Languagesystems;
}
);
