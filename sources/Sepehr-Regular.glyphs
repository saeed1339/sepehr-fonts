{
code = "# GSUB feature: Localized Forms
# Lookups: 3

  script latn; # Latin
    language AZE ; # Azerbaijani

    lookup locl_latn {
    # GSUB lookup 12, type 11 (Single)
      sub i by i.loclTRK;
    } locl_latn;


    language TRK ; # Turkish
    lookup locl_latn;

    language MOL ; # Moldavian

    lookup locl_latnMOL_latnROM {
    # GSUB lookup 13, type 11 (Single)
      sub [Scedilla uni0162 scedilla uni0163] by [uni0218 uni021A uni0219 uni021B];
    } locl_latnMOL_latnROM;


    language ROM ; # Romanian
    lookup locl_latnMOL_latnROM;

    language CAT ; # Catalan
    sub l periodcentered' l by periodcentered.loclCAT;
    sub L periodcentered' L by periodcentered.loclCAT;

    language TAT ; # Tatar
    lookup locl_latn;

    language CRT ; # Crimean Tatar
    lookup locl_latn;

    language KAZ ; # Kazakh
    lookup locl_latn;";
