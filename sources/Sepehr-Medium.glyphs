languagesystem latn TRK ; # Latin Turkish
languagesystem arab dflt; # Arabic default
languagesystem arab ARA ; # Arabic Arabic
languagesystem grek dflt; # Greek default

#
# Lookup definitions
#


#
# Feature definitions
#
";
tag = Languagesystems;
}
);
